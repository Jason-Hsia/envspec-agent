  "_meta": {
    "version": "1.0",
    "n_items": 24,
    "labeling": "人工标注。retrieval 类指标依赖 expected_clause_ids；生成类依赖 key_points 与 expected_numbers。",
    "categories": {
      "limit_lookup": "限值直查，考检索精度与数值准确率",
      "staleness": "时效性陷阱，语料中并存失效版本，考 check_standard_status 是否被调用",
      "precedence": "标准适用优先级裁决，考 resolve_applicable_standard",
      "eia_class": "环评类别判定，考名录工具",
      "refusal": "无依据应拒答，考幻觉抑制",
      "multi_constraint": "多条件组合（介质+等级+属地+时段）"
    },
    "note": "本评测集建立在未核验的演示数据上，仅用于验证评测管线本身。生产环境需重建独立评测集。"
  },
